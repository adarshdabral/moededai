# ============================
# Application
# ============================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ============================
# MongoDB
# ============================
MONGO_URI=mongodb://localhost:27017/moded_ai_dev

# ============================
# JWT
# ============================
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================
# Google Gemini (AI Provider)
# ============================
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# ============================
# CORS
# ============================
CORS_ORIGIN=http://localhost:3000

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================
# File Upload
# ============================
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# ============================
# Logging
# ============================
LOG_LEVEL=info

# ============================
# Email (see src/common/email)
# ============================
EMAIL_PROVIDER=console

# ============================
# Admin bootstrap (npm run seed)
# Creates the first admin account. Leave unset to skip seeding.
# ============================
ADMIN_SEED_EMAIL=admin@moded.ai
ADMIN_SEED_PASSWORD=Pass123
ADMIN_SEED_NAME=Platform Admin
