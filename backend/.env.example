# ============================
# Application
# ============================
NODE_ENV=development
# 5000 conflicts with macOS AirPlay Receiver (Control Center) on many machines.
PORT=5001
API_PREFIX=/api/v1

# ============================
# MongoDB
# ============================
MONGO_URI=mongodb://localhost:27017/moded_ai_dev
# Used only outside production, if MONGO_URI can't be reached after retries.
MONGO_URI_FALLBACK=mongodb://127.0.0.1:27017/moded_dev

# ============================
# JWT
# ============================
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================
# Groq (AI Provider)
# ============================
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ============================
# CORS
# ============================
CORS_ORIGIN=http://localhost:3000

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================
# File Upload
# ============================
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# ============================
# Logging
# ============================
LOG_LEVEL=info

# ============================
# Email (see src/common/email)
# ============================
EMAIL_PROVIDER=console

# ============================
# Admin bootstrap (npm run seed)
# Creates the first admin account. Leave unset to skip seeding.
# ============================
ADMIN_SEED_EMAIL=admin@moded.ai
ADMIN_SEED_PASSWORD=Pass123
ADMIN_SEED_NAME=Platform Admin

# ============================
# Demo data (npm run seed:demo)
# Creates one default teacher and one default student account, plus a sample
# course, so the frontend has content without manual setup. Dev/demo only -
# never run this against a production database.
# ============================
DEMO_TEACHER_EMAIL=teacher@moded.ai
DEMO_TEACHER_PASSWORD=DemoPass123!
DEMO_TEACHER_NAME=Dana Reyes
DEMO_STUDENT_EMAIL=student@moded.ai
DEMO_STUDENT_PASSWORD=DemoPass123!
DEMO_STUDENT_NAME=Sam Okafor
